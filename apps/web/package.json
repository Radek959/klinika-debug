{
  "name": "@klinika/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "copy:workshop-logs": "node ../../scripts/copy-workshop-logs-web.cjs",
    "copy:workshop-docs": "node ../../scripts/copy-workshop-docs-web.cjs",
    "predev": "npm run copy:workshop-logs && npm run copy:workshop-docs",
    "prebuild": "npm run copy:workshop-logs && npm run copy:workshop-docs",
    "build": "tsc -p tsconfig.build.json && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@klinika/api-contracts": "0.1.0",
    "@klinika/domain": "0.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^30.0.1",
    "vitest": "^5.0.0"
  }
}
