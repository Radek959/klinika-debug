{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@klinika/api-contracts$": "<rootDir>/../../packages/api-contracts/src",
    "^@klinika/domain$": "<rootDir>/../../packages/domain/src"
  },
  "testEnvironment": "node"
}
