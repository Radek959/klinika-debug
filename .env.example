NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
DATABASE_URL=mysql://klinika:klinika_local_password@localhost:3306/klinika_debug
TEST_DATABASE_URL=mysql://klinika:klinika_local_password@localhost:3307/klinika_debug_test
SESSION_TOKEN_PEPPER=local-development-pepper-change-me
SEED_STAFF_PASSWORD=HasloTestowe123!
# Hasło kont STAFF tworzonych przez provisioning workspace'ów warsztatowych
# (npm run workshop:seed). Wymagane w środowisku produkcyjnym/warsztatowym —
# provisioning odmawia startu bez tej zmiennej, gdy NODE_ENV=production.
# Wartość poniżej jest bezpieczna wyłącznie lokalnie/testowo.
WORKSHOP_STAFF_PASSWORD=WarsztatTestowe123!
ADMIN_PASSWORD_HASH=local-development-admin-hash-placeholder
ADMIN_SESSION_SECRET=local-development-admin-session-secret
LAB_OUTBOUND_SECRET=local-development-lab-outbound-secret
LAB_WEBHOOK_SECRET=local-development-lab-webhook-secret
# Globalny scenariusz symulatora laboratorium: SUCCESS (domyślny), PARTIAL_SUCCESS,
# SAMPLE_REJECTED, VALIDATION_ERROR, RATE_LIMIT albo SERVER_ERROR.
# SUCCESS, PARTIAL_SUCCESS i SAMPLE_REJECTED są asynchroniczne: wysyłka kończy się
# powodzeniem, a wynik przychodzi callbackiem. VALIDATION_ERROR jest synchroniczny:
# POST /api/v1/orders/{orderId}/send zwraca 422 (LAB_ORDER_VALIDATION_ERROR),
# zlecenie zostaje w statusie SAMPLE_COLLECTED, nie powstaje klucz idempotencji ani
# zadanie w lab_jobs, a wysyłkę można ponowić.
# RATE_LIMIT symuluje chwilowe ograniczenie przepustowości laboratorium: pierwsza
# próba wysyłki zwraca 429 (LAB_RATE_LIMITED) z nagłówkiem Retry-After: 15, zlecenie
# zostaje w statusie SAMPLE_COLLECTED (bez TECHNICAL_ERROR), powstaje jeden
# zarezerwowany klucz idempotencji i jedno trwałe zadanie w lab_send_retry_jobs.
# Po 15 sekundach scheduler automatycznie ponawia wysyłkę, laboratorium przyjmuje
# zlecenie jak w SUCCESS i dalszy proces jest standardowy (callback z wynikami).
# To poprawnie obsłużone ograniczenie integracji, a nie defekt aplikacji.
# SERVER_ERROR symuluje kontrolowaną niedostępność laboratorium: pierwsza próba
# zwraca 503 (LAB_SERVER_ERROR) z Retry-After: 15, a scheduler wykonuje trzy
# automatyczne ponowienia po 15, 30 i 60 sekundach. W tym scenariuszu każde
# wywołanie laboratorium kończy się 5xx; po trzecim retry zlecenie przechodzi
# do TECHNICAL_ERROR, bez callbacka i bez wyników.
# Nieprawidłowa wartość zatrzymuje start aplikacji. Docelowo zastąpi to
# konfiguracja panelu /admin (poza zakresem tego etapu).
LAB_SIMULATOR_SCENARIO=SUCCESS
LOG_LEVEL=info
