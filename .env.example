NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
DATABASE_URL=mysql://klinika:klinika_local_password@localhost:3306/klinika_debug
TEST_DATABASE_URL=mysql://klinika:klinika_local_password@localhost:3307/klinika_debug_test
SESSION_TOKEN_PEPPER=local-development-pepper-change-me
SEED_STAFF_PASSWORD=HasloTestowe123!
# Hasło kont STAFF tworzonych przez provisioning workspace'ów warsztatowych
# (npm run workshop:seed, npm run workshop:prepare). Wymagane w środowisku
# produkcyjnym/warsztatowym — provisioning odmawia startu bez tej zmiennej,
# gdy NODE_ENV=production. Wartość poniżej jest bezpieczna wyłącznie
# lokalnie/testowo.
WORKSHOP_STAFF_PASSWORD=WarsztatTestowe123!
# Liczba uczestników przygotowywanych przez `npm run workshop:prepare`
# (workspace'y warsztat-01..NN i konta testerXX). Opcjonalne — domyślnie 15.
# NIE resetuje istniejących danych: ponowne uruchomienie dla tej samej albo
# mniejszej liczby uczestników jest bezpieczne (idempotentne upsert).
WORKSHOP_PARTICIPANTS=15
# Hasło panelu prowadzącego (/admin) — MUSI odpowiadać hashowi w
# ADMIN_PASSWORD_HASH poniżej. Ta para (hasło + hash) jest jawna i
# deterministyczna WYŁĄCZNIE do local development (dokładnie ten sam wzorzec
# co lokalne SEED_STAFF_PASSWORD/WORKSHOP_STAFF_PASSWORD powyżej) — po
# `Copy-Item .env.example .env` logowanie do lokalnego /admin działa od razu,
# bez ręcznego generowania hashy. NIGDY nie używaj tej pary na Hostingerze ani
# w żadnym innym środowisku produkcyjnym/wdrożonym — produkcja wymaga
# WŁASNEGO, unikalnego hasła i WŁASNEGO wygenerowanego hasha (patrz komenda
# przy ADMIN_PASSWORD_HASH niżej). Ta sama zmienna jest też używana jako
# sekret przez `npm run workshop:smoke` i `npm run test:workshop-browser`
# (Playwright) do zalogowania się do /admin — przy uruchomieniu przeciwko
# WDROŻONEMU środowisku (workshop:smoke, WORKSHOP_BASE_URL) nadpisz ją
# prawdziwym, produkcyjnym hasłem panelu, a nie tą lokalną wartością.
WORKSHOP_ADMIN_PASSWORD=AdminWarsztat123!
# Hash argon2id dokładnie hasła WORKSHOP_ADMIN_PASSWORD powyżej — para działa
# "out of the box" lokalnie. Aby wygenerować WŁASNY hash (produkcja/inne
# hasło lokalne), użyj:
#   node -e "require('argon2').hash('TwojeHasloProwadzacego').then(console.log)"
ADMIN_PASSWORD_HASH="$argon2id$v=19$m=65536,t=3,p=4$yXYzp+iCyg12o6PxmwLZUg$NorGS5groJee9JguSO3VR1X5x7Yh6iLGpeV77dorpas"
# Sekret podpisujący sesję panelu /admin (osobną od sesji STAFF). Nigdy nie
# jest logowany ani zwracany w odpowiedzi API.
ADMIN_SESSION_SECRET=local-development-admin-session-secret
# Poniższa zmienna jest sekretem WYŁĄCZNIE `npm run workshop:smoke` (smoke
# test przeciwko WDROŻONEMU środowisku) — nie jest odczytywana przez samą
# aplikację i nigdy nie trafia do jej logów. Smoke NIGDY nie zgaduje hosta —
# brak tej zmiennej zatrzymuje start.
WORKSHOP_BASE_URL=https://klinikadebug.rwasik.pl
# `npm run test:workshop-browser` (Playwright) UŻYWA WORKSHOP_STAFF_PASSWORD
# i WORKSHOP_ADMIN_PASSWORD powyżej, ale NIGDY WORKSHOP_BASE_URL — to
# świadomy podział: WORKSHOP_BASE_URL wskazuje wdrożone środowisko
# (workshop:smoke), a Playwright działa WYŁĄCZNIE lokalnie. Adresem dla
# Playwrighta jest osobna zmienna, domyślnie http://localhost:3000 (nie
# trzeba jej ustawiać przy standardowym porcie):
# WORKSHOP_BROWSER_BASE_URL=http://localhost:3000
# Ten suite jest zawsze destrukcyjny (tworzy dane, resetuje środowisko), więc
# dodatkowo wymaga jawnego potwierdzenia — bez niego kończy się błędem:
# WORKSHOP_E2E_CONFIRM=RUN
LAB_OUTBOUND_SECRET=local-development-lab-outbound-secret
LAB_WEBHOOK_SECRET=local-development-lab-webhook-secret
# Globalny scenariusz symulatora laboratorium: SUCCESS (domyślny), PARTIAL_SUCCESS,
# SAMPLE_REJECTED, VALIDATION_ERROR, RATE_LIMIT albo SERVER_ERROR.
# SUCCESS, PARTIAL_SUCCESS i SAMPLE_REJECTED są asynchroniczne: wysyłka kończy się
# powodzeniem, a wynik przychodzi callbackiem. VALIDATION_ERROR jest synchroniczny:
# POST /api/v1/orders/{orderId}/send zwraca 422 (LAB_ORDER_VALIDATION_ERROR),
# zlecenie zostaje w statusie SAMPLE_COLLECTED, nie powstaje klucz idempotencji ani
# zadanie w lab_jobs, a wysyłkę można ponowić.
# RATE_LIMIT symuluje chwilowe ograniczenie przepustowości laboratorium: pierwsza
# próba wysyłki zwraca 429 (LAB_RATE_LIMITED) z nagłówkiem Retry-After: 15, zlecenie
# zostaje w statusie SAMPLE_COLLECTED (bez TECHNICAL_ERROR), powstaje jeden
# zarezerwowany klucz idempotencji i jedno trwałe zadanie w lab_send_retry_jobs.
# Po 15 sekundach scheduler automatycznie ponawia wysyłkę, laboratorium przyjmuje
# zlecenie jak w SUCCESS i dalszy proces jest standardowy (callback z wynikami).
# To poprawnie obsłużone ograniczenie integracji, a nie defekt aplikacji.
# SERVER_ERROR symuluje kontrolowaną niedostępność laboratorium: pierwsza próba
# zwraca 503 (LAB_SERVER_ERROR) z Retry-After: 15, a scheduler wykonuje trzy
# automatyczne ponowienia po 15, 30 i 60 sekundach. W tym scenariuszu każde
# wywołanie laboratorium kończy się 5xx; po trzecim retry zlecenie przechodzi
# do TECHNICAL_ERROR, bez callbacka i bez wyników.
# Nieprawidłowa wartość zatrzymuje start aplikacji.
# Od PR-a workshop-trainer-controls ta zmienna jest tylko wartością STARTOWĄ
# (bootstrap): jest odczytywana wyłącznie raz, przy pierwszym uruchomieniu na
# świeżo zmigrowanej bazie, żeby zainicjować wiersz `workshop_config`. Każda
# NOWA wysyłka do laboratorium czyta bieżący scenariusz z panelu /admin
# (WorkshopConfigService), a nie ponownie z tej zmiennej. Zmiana scenariusza w
# panelu /admin NIE wymaga restartu aplikacji.
LAB_SIMULATOR_SCENARIO=SUCCESS
