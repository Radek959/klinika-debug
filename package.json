{
  "name": "klinika-debug",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@klinika/api-contracts && npm run build --workspace=@klinika/domain && npm run build --workspace=@klinika/web && npm run build --workspace=@klinika/api",
    "build:hostinger": "npm run db:generate && npm run build && npm run db:migrate",
    "build:hostinger:seed": "npm run build:hostinger && npm run db:seed && npm run workshop:prepare",
    "build:hostinger:workshop": "npm run build:hostinger && npm run workshop:prepare",
    "start": "npm run start:prod --workspace=@klinika/api",
    "dev:api": "npm run dev --workspace=@klinika/api",
    "dev:web": "npm run dev --workspace=@klinika/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:safety && npm run test --workspaces --if-present && npm run test:workshop-logs && npm run test:workshop-logs-web-copy && npm run test:workshop-docs-web-copy && npm run test:workshop-smoke",
    "test:safety": "node scripts/test-database-safety.spec.cjs",
    "test:workshop-logs": "node scripts/validate-workshop-logs.cjs",
    "test:workshop-logs-web-copy": "node --test scripts/workshop-logs-web-copy.test.cjs",
    "test:workshop-docs-web-copy": "node --test scripts/workshop-docs-web-copy.test.cjs",
    "copy:workshop-logs-web": "node scripts/copy-workshop-logs-web.cjs",
    "copy:workshop-docs-web": "node scripts/copy-workshop-docs-web.cjs",
    "test:workshop-smoke": "node --test scripts/workshop-smoke/*.test.cjs",
    "workshop:smoke": "node scripts/workshop-smoke.cjs",
    "generate:workshop-logs": "node scripts/generate-workshop-logs.cjs",
    "test:integration": "node scripts/run-with-test-database.cjs jest-e2e",
    "test:migration:patients": "node scripts/test-patient-migration.cjs",
    "test:migration:orders": "node scripts/test-orders-foundation-migration.cjs",
    "test:migration:order-history": "node scripts/test-order-history-migration.cjs",
    "test:migration:lab-sample-rejected": "node scripts/test-lab-sample-rejected-migration.cjs",
    "test:migration:lab-validation-error": "node scripts/test-lab-order-rejected-migration.cjs",
    "test:migration:lab-rate-limit": "node scripts/test-lab-send-retry-migration.cjs",
    "test:migration:workshop-config": "node scripts/test-workshop-config-migration.cjs",
    "test:production-start": "node scripts/smoke-production-start.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:test": "node scripts/run-with-test-database.cjs prisma-migrate-deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "workshop:seed": "ts-node --project tsconfig.base.json prisma/workshop-seed.ts",
    "workshop:prepare": "ts-node --project tsconfig.base.json prisma/workshop-prepare.ts",
    "workshop:reset": "ts-node --project tsconfig.base.json prisma/workshop-reset.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "mariadb": "3.4.7",
    "prisma": "^6.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "@nestjs/platform-fastify@11.2.3": {
      "fastify": "5.12.3"
    },
    "@prisma/adapter-mariadb@6.19.3": {
      "mariadb": "3.4.7"
    }
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.base.json prisma/seed.ts"
  },
  "engines": {
    "node": ">=22"
  }
}
