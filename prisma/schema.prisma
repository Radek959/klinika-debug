generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STAFF
}

enum IdentifierType {
  PESEL
  OTHER_DOCUMENT
}

enum Gender {
  FEMALE
  MALE
}

enum OrderPriority {
  ROUTINE
  URGENT
}

enum OrderStatus {
  DRAFT
  SAMPLE_COLLECTION_IN_PROGRESS
  SAMPLE_COLLECTED
  SENT_TO_LAB
  PROCESSING
  PARTIAL
  COMPLETED
  REJECTED
  TECHNICAL_ERROR
}

enum SampleStatus {
  REQUIRED
  COLLECTED
  SENT
  ACCEPTED
  REJECTED
}

enum MaterialType {
  EDTA_BLOOD
  SERUM
  URINE
}

enum TestParameterValueType {
  NUMERIC
  TEXT
}

enum MedicalTestRequiredFieldValueType {
  BOOLEAN
  TEXT
}

enum OrderTestStatus {
  PENDING
  COMPLETED
}

enum ResultFlag {
  LOW
  NORMAL
  HIGH
  NOT_APPLICABLE
}

enum LabJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  patients  Patient[]
  guardians Guardian[]
  orders    Order[]
  orderTests OrderTest[]
  samples   Sample[]
  idempotencyKeys IdempotencyKey[]
  results   Result[]
  labJobs   LabJob[]
  processedLabEvents ProcessedLabEvent[]

  @@map("workspaces")
}

model User {
  id           String   @id @default(cuid())
  workspaceId  String
  login        String   @unique
  displayName  String
  role         UserRole @default(STAFF)
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions  UserSession[]
  createdOrders Order[]   @relation("OrderCreatedByUser")
  collectedSamples Sample[] @relation("SampleCollectedByUser")

  @@unique([workspaceId, id], map: "users_workspace_id_key")
  @@index([workspaceId])
  @@map("users")
}

model UserSession {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  lastActivityAt DateTime
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Patient {
  id                     String         @id @default(cuid())
  workspaceId            String
  firstName              String
  lastName               String
  identifierType         IdentifierType
  pesel                  String?
  documentType           String?
  documentNumber         String?
  documentCountry        String?
  birthDate              DateTime       @db.Date
  gender                 Gender
  citizenship            String?
  phone                  String?
  email                  String?
  addressStreet          String?
  addressBuildingNumber  String?
  addressApartmentNumber String?
  addressPostalCode      String?
  addressCity            String?
  addressCountry         String?
  active                 Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  guardian  Guardian?
  orders    Order[]

  @@unique([workspaceId, pesel], map: "patients_workspace_pesel_key")
  @@unique([workspaceId, documentType, documentNumber, documentCountry], map: "patients_workspace_document_key")
  @@unique([workspaceId, id], map: "patients_workspace_id_key")
  @@index([workspaceId], map: "patients_workspace_idx")
  @@index([workspaceId, lastName, firstName], map: "patients_workspace_name_idx")
  @@index([workspaceId, birthDate], map: "patients_workspace_birth_date_idx")
  @@index([workspaceId, createdAt], map: "patients_workspace_created_at_idx")
  @@index([workspaceId, active], map: "patients_workspace_active_idx")
  @@map("patients")
}

model Guardian {
  id          String   @id @default(cuid())
  workspaceId String
  patientId   String   @unique
  firstName   String
  lastName    String
  phone       String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   Patient   @relation(fields: [workspaceId, patientId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, patientId], map: "guardians_workspace_patient_key")
  @@index([workspaceId], map: "guardians_workspace_idx")
  @@map("guardians")
}

model MedicalTest {
  id                       String                     @id @default(cuid())
  code                     String                     @unique(map: "medical_tests_code_key")
  name                     String
  description              String
  materialType             MaterialType
  estimatedDurationMinutes Int
  active                   Boolean                    @default(true)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  parameters     TestParameter[]
  requiredFields MedicalTestRequiredField[]
  orderTests     OrderTest[]

  @@index([active], map: "medical_tests_active_idx")
  @@index([materialType], map: "medical_tests_material_type_idx")
  @@map("medical_tests")
}

model TestParameter {
  id            String                 @id @default(cuid())
  medicalTestId String
  code          String
  name          String
  valueType     TestParameterValueType
  unit          String?
  displayOrder  Int
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  medicalTest MedicalTest @relation(fields: [medicalTestId], references: [id], onDelete: Cascade)

  @@unique([medicalTestId, code], map: "test_parameters_test_code_key")
  @@index([medicalTestId, displayOrder], map: "test_parameters_test_order_idx")
  @@map("test_parameters")
}

model MedicalTestRequiredField {
  id            String                            @id @default(cuid())
  medicalTestId String
  code          String
  label         String
  valueType     MedicalTestRequiredFieldValueType
  required      Boolean
  displayOrder  Int
  createdAt     DateTime                          @default(now())
  updatedAt     DateTime                          @updatedAt

  medicalTest MedicalTest @relation(fields: [medicalTestId], references: [id], onDelete: Cascade)

  @@unique([medicalTestId, code], map: "medical_test_required_fields_test_code_key")
  @@index([medicalTestId, displayOrder], map: "medical_test_required_fields_test_order_idx")
  @@map("medical_test_required_fields")
}

model Order {
  id                    String        @id @default(cuid())
  workspaceId           String
  patientId             String
  createdByUserId       String
  priority              OrderPriority
  status                OrderStatus   @default(DRAFT)
  externalOrderId       String?       @unique(map: "orders_external_order_id_key")
  correlationId         String?
  sentAt                DateTime?
  estimatedCompletionAt DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient       Patient     @relation(fields: [workspaceId, patientId], references: [workspaceId, id], onDelete: Restrict)
  createdByUser User        @relation("OrderCreatedByUser", fields: [workspaceId, createdByUserId], references: [workspaceId, id], onDelete: Restrict)
  tests         OrderTest[]
  samples       Sample[]
  idempotencyKeys IdempotencyKey[]
  results       Result[]
  labJobs       LabJob[]
  processedLabEvents ProcessedLabEvent[]

  @@unique([workspaceId, id], map: "orders_workspace_id_key")
  @@index([workspaceId, patientId], map: "orders_workspace_patient_idx")
  @@index([workspaceId, createdByUserId], map: "orders_workspace_created_by_idx")
  @@index([workspaceId, status], map: "orders_workspace_status_idx")
  @@index([workspaceId, createdAt], map: "orders_workspace_created_at_idx")
  @@map("orders")
}

model OrderTest {
  id            String   @id @default(cuid())
  workspaceId   String
  orderId       String
  medicalTestId String
  additionalData Json?
  status        OrderTestStatus @default(PENDING)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order       Order       @relation(fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Cascade)
  medicalTest MedicalTest @relation(fields: [medicalTestId], references: [id], onDelete: Restrict)

  @@unique([orderId, medicalTestId], map: "order_tests_order_medical_test_key")
  @@index([workspaceId, orderId], map: "order_tests_workspace_order_idx")
  @@index([medicalTestId], map: "order_tests_medical_test_idx")
  @@map("order_tests")
}

model Sample {
  id                String       @id @default(cuid())
  workspaceId       String
  orderId           String
  materialType      MaterialType
  barcode           String?
  collectedAt       DateTime?
  collectedByUserId String?
  status            SampleStatus @default(REQUIRED)
  rejectionCode     String?
  rejectionReason   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order           Order     @relation(fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Cascade)
  collectedByUser User?     @relation("SampleCollectedByUser", fields: [workspaceId, collectedByUserId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([orderId, materialType], map: "samples_order_material_type_key")
  @@unique([workspaceId, barcode], map: "samples_workspace_barcode_key")
  @@index([workspaceId, orderId], map: "samples_workspace_order_idx")
  @@index([workspaceId, collectedByUserId], map: "samples_workspace_collected_by_idx")
  @@map("samples")
}

model IdempotencyKey {
  id             String   @id @default(cuid())
  workspaceId    String
  orderId        String
  key            String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, key], map: "idempotency_keys_workspace_key_key")
  @@index([workspaceId, orderId], map: "idempotency_keys_workspace_order_idx")
  @@map("idempotency_keys")
}

model Result {
  id             String     @id @default(cuid())
  workspaceId    String
  orderId        String
  medicalTestId  String
  parameterCode  String
  value          String
  unit           String?
  referenceRange String?
  flag           ResultFlag
  resultedAt     DateTime
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([orderId, medicalTestId, parameterCode], map: "results_order_test_parameter_key")
  @@index([workspaceId, orderId], map: "results_workspace_order_idx")
  @@map("results")
}

model LabJob {
  id          String       @id @default(cuid())
  workspaceId String
  orderId     String
  scenario    String
  payload     Json
  executeAt   DateTime
  status      LabJobStatus @default(PENDING)
  attempts    Int          @default(0)
  lockedAt    DateTime?
  lastError   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Cascade)

  @@index([status, executeAt], map: "lab_jobs_status_execute_at_idx")
  @@index([workspaceId, orderId], map: "lab_jobs_workspace_order_idx")
  @@map("lab_jobs")
}

model ProcessedLabEvent {
  id          String   @id @default(cuid())
  workspaceId String
  orderId     String
  eventId     String
  processedAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, eventId], map: "processed_lab_events_workspace_event_key")
  @@index([workspaceId, orderId], map: "processed_lab_events_workspace_order_idx")
  @@map("processed_lab_events")
}
