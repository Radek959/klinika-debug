generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STAFF
}

enum IdentifierType {
  PESEL
  OTHER_DOCUMENT
}

enum Gender {
  FEMALE
  MALE
}

enum OrderPriority {
  ROUTINE
  URGENT
}

enum OrderStatus {
  DRAFT
  SAMPLE_COLLECTION_IN_PROGRESS
  SAMPLE_COLLECTED
  SENT_TO_LAB
  PROCESSING
  PARTIAL
  COMPLETED
  REJECTED
  TECHNICAL_ERROR
}

enum SampleStatus {
  REQUIRED
  COLLECTED
  SENT
  ACCEPTED
  REJECTED
}

enum MaterialType {
  EDTA_BLOOD
  SERUM
  URINE
}

enum TestParameterValueType {
  NUMERIC
  TEXT
}

enum MedicalTestRequiredFieldValueType {
  BOOLEAN
  TEXT
}

enum OrderTestStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum ResultFlag {
  LOW
  NORMAL
  HIGH
  NOT_APPLICABLE
}

enum LabJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum LabSendRetryJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum OrderHistoryEventType {
  ORDER_CREATED
  ORDER_UPDATED
  SAMPLE_REGISTERED
  ORDER_SENT_TO_LAB
  LAB_ORDER_ACCEPTED
  LAB_RESULT_RECEIVED
  LAB_SAMPLE_REJECTED
  LAB_ORDER_REJECTED
  LAB_RATE_LIMIT_RECEIVED
  LAB_SEND_TIMEOUT_RECEIVED
  LAB_SEND_RETRY
  TECHNICAL_ERROR
}

enum OrderHistoryActorType {
  STAFF
  SYSTEM
  LAB
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  patients  Patient[]
  guardians Guardian[]
  orders    Order[]
  orderTests OrderTest[]
  samples   Sample[]
  idempotencyKeys IdempotencyKey[]
  results   Result[]
  labJobs   LabJob[]
  labSendRetryJobs LabSendRetryJob[]
  processedLabEvents ProcessedLabEvent[]
  orderHistory OrderHistory[]

  @@map("workspaces")
}

model User {
  id           String   @id @default(cuid())
  workspaceId  String
  login        String   @unique
  displayName  String
  role         UserRole @default(STAFF)
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions  UserSession[]
  createdOrders Order[]   @relation("OrderCreatedByUser")
  collectedSamples Sample[] @relation("SampleCollectedByUser")
  orderHistoryEntries OrderHistory[] @relation("OrderHistoryActorUser")

  @@unique([workspaceId, id], map: "users_workspace_id_key")
  @@index([workspaceId])
  @@map("users")
}

model UserSession {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  lastActivityAt DateTime
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Patient {
  id                     String         @id @default(cuid())
  workspaceId            String
  firstName              String
  lastName               String
  identifierType         IdentifierType
  pesel                  String?
  documentType           String?
  documentNumber         String?
  documentCountry        String?
  birthDate              DateTime       @db.Date
  gender                 Gender
  citizenship            String?
  phone                  String?
  email                  String?
  addressStreet          String?
  addressBuildingNumber  String?
  addressApartmentNumber String?
  addressPostalCode      String?
  addressCity            String?
  addressCountry         String?
  active                 Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  guardian  Guardian?
  orders    Order[]

  @@unique([workspaceId, pesel], map: "patients_workspace_pesel_key")
  @@unique([workspaceId, documentType, documentNumber, documentCountry], map: "patients_workspace_document_key")
  @@unique([workspaceId, id], map: "patients_workspace_id_key")
  @@index([workspaceId], map: "patients_workspace_idx")
  @@index([workspaceId, lastName, firstName], map: "patients_workspace_name_idx")
  @@index([workspaceId, birthDate], map: "patients_workspace_birth_date_idx")
  @@index([workspaceId, createdAt], map: "patients_workspace_created_at_idx")
  @@index([workspaceId, active], map: "patients_workspace_active_idx")
  @@map("patients")
}

model Guardian {
  id          String   @id @default(cuid())
  workspaceId String
  patientId   String   @unique
  firstName   String
  lastName    String
  phone       String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   Patient   @relation(fields: [workspaceId, patientId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, patientId], map: "guardians_workspace_patient_key")
  @@index([workspaceId], map: "guardians_workspace_idx")
  @@map("guardians")
}

model MedicalTest {
  id                       String                     @id @default(cuid())
  code                     String                     @unique(map: "medical_tests_code_key")
  name                     String
  description              String
  materialType             MaterialType
  estimatedDurationMinutes Int
  active                   Boolean                    @default(true)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  parameters     TestParameter[]
  requiredFields MedicalTestRequiredField[]
  orderTests     OrderTest[]

  @@index([active], map: "medical_tests_active_idx")
  @@index([materialType], map: "medical_tests_material_type_idx")
  @@map("medical_tests")
}

model TestParameter {
  id            String                 @id @default(cuid())
  medicalTestId String
  code          String
  name          String
  valueType     TestParameterValueType
  unit          String?
  displayOrder  Int
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  medicalTest MedicalTest @relation(fields: [medicalTestId], references: [id], onDelete: Cascade)

  @@unique([medicalTestId, code], map: "test_parameters_test_code_key")
  @@index([medicalTestId, displayOrder], map: "test_parameters_test_order_idx")
  @@map("test_parameters")
}

model MedicalTestRequiredField {
  id            String                            @id @default(cuid())
  medicalTestId String
  code          String
  label         String
  valueType     MedicalTestRequiredFieldValueType
  required      Boolean
  displayOrder  Int
  createdAt     DateTime                          @default(now())
  updatedAt     DateTime                          @updatedAt

  medicalTest MedicalTest @relation(fields: [medicalTestId], references: [id], onDelete: Cascade)

  @@unique([medicalTestId, code], map: "medical_test_required_fields_test_code_key")
  @@index([medicalTestId, displayOrder], map: "medical_test_required_fields_test_order_idx")
  @@map("medical_test_required_fields")
}

model Order {
  id                    String        @id @default(cuid())
  workspaceId           String
  patientId             String
  createdByUserId       String
  priority              OrderPriority
  status                OrderStatus   @default(DRAFT)
  externalOrderId       String?       @unique(map: "orders_external_order_id_key")
  correlationId         String?
  sentAt                DateTime?
  estimatedCompletionAt DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient       Patient     @relation(fields: [workspaceId, patientId], references: [workspaceId, id], onDelete: Restrict)
  createdByUser User        @relation("OrderCreatedByUser", fields: [workspaceId, createdByUserId], references: [workspaceId, id], onDelete: Restrict)
  tests         OrderTest[]
  samples       Sample[]
  idempotencyKeys IdempotencyKey[]
  results       Result[]
  labJobs       LabJob[]
  labSendRetryJobs LabSendRetryJob[]
  processedLabEvents ProcessedLabEvent[]
  history       OrderHistory[]

  @@unique([workspaceId, id], map: "orders_workspace_id_key")
  @@index([workspaceId, patientId], map: "orders_workspace_patient_idx")
  @@index([workspaceId, createdByUserId], map: "orders_workspace_created_by_idx")
  @@index([workspaceId, status], map: "orders_workspace_status_idx")
  @@index([workspaceId, createdAt], map: "orders_workspace_created_at_idx")
  @@map("orders")
}

model OrderTest {
  id            String   @id @default(cuid())
  workspaceId   String
  orderId       String
  medicalTestId String
  additionalData Json?
  status        OrderTestStatus @default(PENDING)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order       Order       @relation(fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Cascade)
  medicalTest MedicalTest @relation(fields: [medicalTestId], references: [id], onDelete: Restrict)

  @@unique([orderId, medicalTestId], map: "order_tests_order_medical_test_key")
  @@index([workspaceId, orderId], map: "order_tests_workspace_order_idx")
  @@index([medicalTestId], map: "order_tests_medical_test_idx")
  @@map("order_tests")
}

model Sample {
  id                String       @id @default(cuid())
  workspaceId       String
  orderId           String
  materialType      MaterialType
  barcode           String?
  collectedAt       DateTime?
  collectedByUserId String?
  status            SampleStatus @default(REQUIRED)
  rejectionCode     String?
  rejectionReason   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order           Order     @relation(fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Cascade)
  collectedByUser User?     @relation("SampleCollectedByUser", fields: [workspaceId, collectedByUserId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([orderId, materialType], map: "samples_order_material_type_key")
  @@unique([workspaceId, barcode], map: "samples_workspace_barcode_key")
  @@index([workspaceId, orderId], map: "samples_workspace_order_idx")
  @@index([workspaceId, collectedByUserId], map: "samples_workspace_collected_by_idx")
  @@map("samples")
}

model IdempotencyKey {
  id             String   @id @default(cuid())
  workspaceId    String
  orderId        String
  key            String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, key], map: "idempotency_keys_workspace_key_key")
  @@index([workspaceId, orderId], map: "idempotency_keys_workspace_order_idx")
  @@map("idempotency_keys")
}

model Result {
  id             String     @id @default(cuid())
  workspaceId    String
  orderId        String
  medicalTestId  String
  parameterCode  String
  value          String
  unit           String?
  referenceRange String?
  flag           ResultFlag
  resultedAt     DateTime
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([orderId, medicalTestId, parameterCode], map: "results_order_test_parameter_key")
  @@index([workspaceId, orderId], map: "results_workspace_order_idx")
  @@map("results")
}

model LabJob {
  id          String       @id @default(cuid())
  workspaceId String
  orderId     String
  scenario    String
  payload     Json
  executeAt   DateTime
  status      LabJobStatus @default(PENDING)
  attempts    Int          @default(0)
  lockedAt    DateTime?
  lastError   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Cascade)

  @@index([status, executeAt], map: "lab_jobs_status_execute_at_idx")
  @@index([workspaceId, orderId], map: "lab_jobs_workspace_order_idx")
  @@map("lab_jobs")
}

/**
 * Trwałe zadanie automatycznego ponowienia WYSYŁKI zlecenia do laboratorium.
 *
 * Model jest celowo osobny od `LabJob`: `lab_jobs` przechowuje zaplanowane
 * callbacki laboratorium z wynikami, a to są zadania wychodzące, o innym
 * payloadzie i innym cyklu życia. Wciśnięcie obu rodzajów w jedną tabelę dałoby
 * niejasną unię payloadów.
 *
 * Zadanie nie przechowuje żadnych danych pacjenta, PESEL-u, danych kontaktowych,
 * kodów kreskowych, sekretów ani stack trace'ów. Do ponowienia wystarczają
 * identyfikatory zlecenia i workspace'u — pełny payload jest odtwarzany z bazy
 * w chwili wykonania.
 *
 * `scenario` jest zapisywany w momencie utworzenia zadania i NIE jest odczytywany
 * ponownie z globalnej konfiguracji przy wykonaniu: późniejsza zmiana
 * `LAB_SIMULATOR_SCENARIO` nie może zamienić istniejącego zadania w inny scenariusz.
 */
model LabSendRetryJob {
  id             String                @id @default(cuid())
  workspaceId    String
  orderId        String
  /** Numer próby wysyłki, którą wykona to zadanie (pierwsza ręczna próba ma numer 1). */
  attemptNumber  Int
  executeAt      DateTime
  status         LabSendRetryJobStatus @default(PENDING)
  /** Ten sam identyfikator korelacji co pierwotna, ręczna próba wysyłki. */
  correlationId  String
  /** Techniczny scenariusz symulatora utrwalony w chwili zaplanowania zadania. */
  scenario       String
  idempotencyKey String
  requestHash    String
  /** Liczba faktycznie rozpoczętych wykonań zadania przez scheduler. */
  attempts       Int                   @default(0)
  lockedAt       DateTime?
  lastError      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Cascade)

  // MySQL nie ma indeksów częściowych, więc jedno zlecenie ma dokładnie jeden
  // wiersz ponowienia wysyłki. Zadanie zakończone zostaje w tabeli jako DONE i
  // blokuje utworzenie kolejnego duplikatu dla tego samego zlecenia.
  @@unique([workspaceId, orderId], map: "lab_send_retry_jobs_workspace_order_key")
  @@index([status, executeAt], map: "lab_send_retry_jobs_status_execute_at_idx")
  @@index([workspaceId, orderId], map: "lab_send_retry_jobs_workspace_order_idx")
  @@map("lab_send_retry_jobs")
}

model ProcessedLabEvent {
  id          String   @id @default(cuid())
  workspaceId String
  orderId     String
  eventId     String
  processedAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, eventId], map: "processed_lab_events_workspace_event_key")
  @@index([workspaceId, orderId], map: "processed_lab_events_workspace_order_idx")
  @@map("processed_lab_events")
}

/**
 * Globalna, jednowierszowa konfiguracja panelu prowadzącego (`/admin`).
 *
 * Model jest celowo pojedynczym singletonem (`id = "singleton"`), a nie
 * konfiguracją per-workspace ani systemem feature flag: Workshop MVP wymaga
 * tylko jednego globalnego scenariusza laboratorium i jednego aktywnego
 * kontrolowanego błędu naraz. Nie ma tu historii ani audytu zmian — tylko
 * bieżący stan.
 *
 * `labScenario` i `controlledBug` są trzymane jako `String`, a nie enum bazy
 * danych: dozwolone wartości waliduje warstwa aplikacyjna
 * (`WorkshopConfigService`), więc rozszerzenie zestawu kontrolowanych błędów
 * w kolejnym PR-ze (`workshop-controlled-bugs`) nie wymaga kolejnej migracji
 * zmieniającej enum.
 */
model WorkshopConfig {
  id            String   @id
  labScenario   String
  controlledBug String
  updatedAt     DateTime @updatedAt

  @@map("workshop_config")
}

model OrderHistory {
  id                 String                @id @default(cuid())
  workspaceId        String
  orderId            String
  sequence           Int                   @unique(map: "order_history_sequence_key") @default(autoincrement())
  eventType          OrderHistoryEventType
  actorType          OrderHistoryActorType
  actorUserId        String?
  occurredAt         DateTime
  correlationId      String?
  integrationEventId String?
  previousStatus     OrderStatus?
  newStatus          OrderStatus?
  details            Json
  createdAt          DateTime              @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Cascade)
  actorUser User?     @relation("OrderHistoryActorUser", fields: [workspaceId, actorUserId], references: [workspaceId, id], onDelete: Restrict)

  @@index([workspaceId, orderId, occurredAt, sequence], map: "order_history_workspace_order_occurred_idx")
  @@index([workspaceId, actorUserId], map: "order_history_workspace_actor_idx")
  @@unique([workspaceId, integrationEventId, eventType], map: "order_history_workspace_integration_event_key")
  @@map("order_history")
}
